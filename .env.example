PORTAL_URL=https://console.example.com
DEVICE_DOMAIN=console.example.com
OIDC_ISSUER=https://auth.example.com/application/o/web-console/
OIDC_CLIENT_ID=replace-with-authentik-client-id
OIDC_ALLOWED_SUB=replace-with-your-stable-oidc-subject
# Bind to the reverse proxy's reachable interface when it is on another host.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
# Use web-console:v0.1.0-amd64 / web-console:v0.1.0-arm64 for offline images.
WEBCONSOLE_IMAGE=ghcr.io/keviince/web-console:latest
# Source builds only; optionally use https://goproxy.cn,direct.
GO_MODULE_PROXY=https://proxy.golang.org,direct
